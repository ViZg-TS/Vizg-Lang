+fn bitSet(words: []const u64, ordinal: usize) bool {
+    const word = ordinal / 64;
+    if (word >= words.len) return false;
+    const bit: u6 = @intCast(ordinal % 64);
+    return (words[word] & (@as(u64, 1) << bit)) != 0;
